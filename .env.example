# Cerebras Inference (required for live agent runs)
# https://cloud.cerebras.ai  → API Keys
CEREBRAS_API_KEY=
CEREBRAS_MODEL=qwen-3.8-27b

# Optional: live Business Central customer search (same as sizing tool)
MICROSERVICE_URL=
MICROSERVICE_API_KEY=

# AI Product Sizing (engineer bench)
SIZING_BASE_URL=https://sizing.dayliff.com

# Same Business Central OData as the sizing app (Customer_Card)
# BC_URL=https://bc.dayliff.com:7048/BC160/ODataV4/Company('KENYA')
BC_URL=
BC_USERNAME=
BC_PASSWORD=

# Engineer notifications (in-app always; email if SMTP is set)
ENGINEER_NOTIFY_EMAIL=
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=

# Optional HubSpot (read contacts / write notes only when governance allows)
HUBSPOT_ACCESS_TOKEN=
HUBSPOT_PORTAL_ID=

# Governance — keep false for the Cafe Compute / SDR pilot
GOVERNANCE_ALLOW_CRM_WRITE=false
GOVERNANCE_AUTO_APPROVE_NONSTRATEGIC=false
